NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional for the local Work rule demo; defaults to http://127.0.0.1:8000
BACKEND_API_URL=http://127.0.0.1:8000
# Authenticated inbox draft service; distinct from the legacy local demo.
# Leave empty when the optional draft backend is not deployed.
# Local formal development may use http://127.0.0.1:8014; hosted uses HTTPS.
WORKSPACE_BACKEND_URL=
# Opt-in single-computer development only. Also set on the backend; never enable on hosted deployments.
HOMESTAY_LOCAL_DATA=0

# Set to 1 on hosted Node servers. Vercel automatically enables hosted mode.
STAYCRAFT_HOSTED=0

# Never set STAYCRAFT_OPERATOR_SAMPLE, STAYCRAFT_QA_AUTH_FIXTURES, or
# STAYCRAFT_QA_FORMAL_STAYS on a hosted deployment.

# Formal automatic delivery remains off until explicitly approved and accepted.
FORMAL_AUTO_REPLY_ENABLED=0
# Optional server-side question classification, never NEXT_PUBLIC; no raw model reply is sent.
FORMAL_MODEL_ENABLED=0
MODEL_ENABLED=0
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
