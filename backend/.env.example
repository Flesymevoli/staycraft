# Set these only in the backend process. Do not put keys in NEXT_PUBLIC variables.
MODEL_ENABLED=0
# Keep formal inbox model calls off until permission/configuration is confirmed.
FORMAL_MODEL_ENABLED=0
# Formal draft routes also need Supabase URL and publishable key (not a secret key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
MODEL_API_KEY=
MODEL_AUTH_MODE=bearer
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
# Optional localhost-only property store; not a hosted authentication substitute.
HOMESTAY_LOCAL_DATA=0
